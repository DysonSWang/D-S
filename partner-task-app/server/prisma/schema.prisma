// Partner Task App - Prisma Schema (SQLite compatible)
// 伙伴任务打卡系统 - 数据库模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==================== 用户系统 ====================

/// 用户表
model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  passwordHash    String
  role            String   @default("GROWER") // ADMIN/GUIDE/GROWER
  nickname        String?
  avatarUrl       String?
  email           String?  @unique
  phone           String?
  timezone        String   @default("Asia/Shanghai")
  status          Int      @default(1) // 0 禁用 1 正常
  safetyWordYellow String?
  safetyWordRed   String?
  ageVerified     Boolean  @default(false)
  // 偏好设置
  taskPreferences String   @default("{}") // JSON: {communication, action, reflection, social, creative}
  rewardPreferences String @default("{\"preferred\":\"bones\"}") // JSON: {preferred}
  suggestionStyle String   @default("gentle") // gentle/direct/humorous
  availableTimeSlots String @default("[]") // JSON: [{start, end, days}]
  boundaries      String   @default("[]") // JSON: [{type, description}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关系
  guideRelationships   Relationship[] @relation("GuideRelationships")
  growerRelationships  Relationship[] @relation("GrowerRelationships")
  taskGuide            Task[]         @relation("TaskGuide")
  taskGrower           Task[]         @relation("TaskGrower")
  rewards              Reward?
  cottage              Cottage?
  decorations          UserDecoration[]
  achievements         UserAchievement[]
  notifications        Notification[]
  messageSender        Message[]      @relation("MessageSender")
  messageReceiver      Message[]      @relation("MessageReceiver")
  collectionProgress   UserCollectionProgress[]
  taskChangeLogs       TaskChangeLog[]

  @@index([username])
  @@index([email])
  @@index([role])
}

// ==================== 关系系统 ====================

/// 伙伴关系表
model Relationship {
  id                  Int      @id @default(autoincrement())
  guideId             Int
  guide               User     @relation("GuideRelationships", fields: [guideId], references: [id])
  growerId            Int
  grower              User     @relation("GrowerRelationships", fields: [growerId], references: [id])
  mode                String   @default("PARTNER") // PARTNER/GUIDE_GROWER
  status              String   @default("PENDING") // PENDING/ACTIVE/DISSOLVING/DISSOLVED
  startDate           DateTime?
  endDate             DateTime?
  agreementContent    String?
  guideSign           String?
  growerSign          String?
  coolingOffDeadline  DateTime?
  certificateUrl      String?
  createdAt           DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // 关系中的任务
  tasks               Task[]
  // 签约记录
  signingRecord       SigningRecord?

  @@unique([guideId, growerId])
  @@index([guideId])
  @@index([growerId])
  @@index([status])
}

// ==================== 签约仪式 ====================

/// 签约记录表
model SigningRecord {
  id              Int      @id @default(autoincrement())
  relationshipId  Int      @unique
  relationship    Relationship @relation(fields: [relationshipId], references: [id])
  agreementContent String   // 协议内容
  guideSignature  String?  // 引导者签名 (base64)
  growerSignature String?  // 成长者签名 (base64)
  oathCompleted   Boolean  @default(false)
  certificateUrl  String?
  signedAt        DateTime @default(now())
  
  @@index([relationshipId])
}

/// 签约日记表
model SigningDiary {
  id              Int      @id @default(autoincrement())
  relationshipId  Int
  userId          Int
  mood            String   // excited/nervous/happy/touched
  thought         String?  // 想法
  expectation     String?  // 期待
  photoUrl        String?
  createdAt       DateTime @default(now())
  
  @@index([relationshipId])
  @@index([userId])
}

// ==================== 任务系统 ====================

/// 任务表
model Task {
  id              Int      @id @default(autoincrement())
  relationshipId  Int
  relationship    Relationship @relation(fields: [relationshipId], references: [id])
  guideId         Int
  guide           User     @relation("TaskGuide", fields: [guideId], references: [id])
  growerId        Int
  grower          User     @relation("TaskGrower", fields: [growerId], references: [id])
  templateId      Int?
  type            String?
  name            String
  description     String?
  difficulty      Int      @default(1) // 1-5
  status          String   @default("PENDING") // PENDING/IN_PROGRESS/PENDING_REVIEW/COMPLETED/REJECTED/CANCELLED/ARCHIVED
  proofType       String   @default("TEXT") // TEXT/IMAGE/VIDEO/BOTH/ALL/NONE
  proofContent    String?  // 文字证明
  proofImages     String?  // JSON 数组：图片 URL 列表
  proofVideos     String?  // JSON 数组：视频 URL 列表
  rewardConfig    String?  // JSON
  suggestionConfig String?
  deadline        DateTime?
  startedAt       DateTime?
  submittedAt     DateTime?
  completedAt     DateTime?
  reviewedAt      DateTime?
  feedback        String?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  archivedBy      Int?
  repeatType      String   @default("NONE") // NONE/DAILY/WEEKLY/MONTHLY/CUSTOM
  repeatConfig    String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([guideId])
  @@index([growerId])
  @@index([relationshipId])
  @@index([status])
}

// ==================== 任务模板 ====================

/// 任务模板表
model TaskTemplate {
  id          Int      @id @default(autoincrement())
  creatorId   Int
  name        String
  description String?
  difficulty  Int      @default(1)
  category    String?
  tags        String?  // JSON array
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([isPublic])
  @@index([category])
}

// ==================== 奖励系统 ====================

/// 奖励资产表
model Reward {
  id        Int      @id @default(autoincrement())
  growerId  Int      @unique
  grower    User     @relation(fields: [growerId], references: [id])
  bones     Int      @default(0)
  fish      Int      @default(0)
  gems      Int      @default(0)
  hearts    Int      @default(0)
  stars     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 奖励流水
  transactions RewardTransaction[]
}

/// 奖励流水表
model RewardTransaction {
  id        Int      @id @default(autoincrement())
  rewardId  Int
  reward    Reward   @relation(fields: [rewardId], references: [id])
  type      String   // EARN/SPEND/GIFT/REVOKE
  amount    Int
  balance   Int      // 交易后余额
  reason    String?
  taskId    Int?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([rewardId])
  @@index([type])
}

// ==================== 奖励商店 ====================

/// 商店商品表
model ShopItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  category    String   @default("DECORATION") // DECORATION/EFFECT/PRIVILEGE/PHYSICAL
  priceType   String   @default("BONES") // BONES/FISH/GEMS/HEARTS/STARS
  price       Int
  stock       Int      @default(-1) // -1 表示无限库存
  limitPerUser Int     @default(1) // 每人限购数量
  itemType    String   @default("DECORATION") // DECORATION/EFFECT/COUPON/PHYSICAL
  itemConfig  String?  // JSON: {decorationId, effectType, couponValue, etc.}
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      ShopOrder[]

  @@index([category])
  @@index([isActive])
  @@index([sort])
}

/// 商店订单表
model ShopOrder {
  id          Int      @id @default(autoincrement())
  userId      Int
  itemId      Int
  item        ShopItem @relation(fields: [itemId], references: [id])
  quantity    Int      @default(1)
  totalPrice  Int
  priceType   String
  status      String   @default("COMPLETED") // PENDING/COMPLETED/SHIPPED/DELIVERED/CANCELLED
  deliveryData String? // JSON: 发货数据（虚拟物品信息/物流单号等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([itemId])
  @@index([status])
}

// ==================== 装饰系统 ====================

/// 装饰系列表 (图鉴分类)
model DecorationCollection {
  id          Int      @id @default(autoincrement())
  name        String   // "温馨家具系列" "春日限定系列"
  description String?
  iconUrl     String?
  totalItems  Int      // 系列总物品数
  bonusReward String?  // JSON: {bones, fish, gems} 收集奖励
  isHidden    Boolean  @default(false)  // 是否隐藏 (收集部分后显示)
  createdAt   DateTime @default(now())

  decorations Decoration[]
  userProgress UserCollectionProgress[]

  @@index([name])
}

/// 装饰物品表
model Decoration {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("FURNITURE") // HOUSE/FURNITURE/WALL/PLANT/EFFECT/PET
  rarity      Int      @default(1) // 1 普通/2 稀有/3 史诗/4 传说
  priceType   String   @default("BONES") // BONES/FISH/GEMS
  price       Int
  warmthBonus Int      @default(0)
  imageUrl    String?
  description String?
  isAvailable Boolean  @default(true)
  collectionId Int?    // 所属系列 ID (图鉴)
  slotType    String   @default("FURNITURE") // 槽位类型 (FURNITURE/WALL/FLOOR/PLANT/EFFECT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 所属系列
  collection  DecorationCollection? @relation(fields: [collectionId], references: [id])
  // 用户拥有的装饰
  userDecorations UserDecoration[]

  @@index([category])
  @@index([collectionId])
  @@index([slotType])
}

/// 用户装饰物品表
model UserDecoration {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  decorationId Int
  decoration   Decoration @relation(fields: [decorationId], references: [id])
  quantity     Int      @default(1)
  isEquipped   Boolean  @default(false)
  slotPosition Int?     // 槽位位置 (1-maxSlots)
  position     String?  // JSON {x, y, rotation} - 预留自由摆放
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, decorationId])
  @@index([userId])
  @@index([isEquipped])
}

// ==================== 小屋系统 ====================

/// 小屋表
model Cottage {
  id            Int      @id @default(autoincrement())
  growerId      Int      @unique
  grower        User     @relation(fields: [growerId], references: [id])
  level         Int      @default(1)
  experience    Int      @default(0)
  warmth        Int      @default(0)
  theme         String?
  backgroundUrl String?
  maxSlots      Int      @default(5)    // 装饰槽位上限 (随等级解锁)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([growerId])
}

// ==================== 图鉴收集系统 ====================

/// 用户收集进度表 (图鉴)
model UserCollectionProgress {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  collectionId Int
  collection   DecorationCollection @relation(fields: [collectionId], references: [id])
  collectedCount Int    @default(0)  // 已收集数量
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, collectionId])
  @@index([userId])
  @@index([isCompleted])
}

// ==================== 任务变更日志 ====================

/// 任务变更日志表
model TaskChangeLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  field     String   // 变更字段：status/name/description/rewardConfig 等
  oldValue  String?  // 原值 (JSON 字符串)
  newValue  String?  // 新值 (JSON 字符串)
  changedBy Int      // 操作人 ID
  changer   User?    @relation(fields: [changedBy], references: [id])
  reason    String?  // 变更原因
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([changedBy])
  @@index([createdAt])
}

// ==================== 成就系统 ====================

/// 成就表
model Achievement {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  iconUrl     String?
  category    String?
  condition   String   // JSON 条件
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@index([category])
}

/// 用户成就表
model UserAchievement {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  achievementId  Int
  achievement    Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt     DateTime @default(now())
  progress       Int      @default(0)
  isClaimed      Boolean  @default(false)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ==================== 消息系统 ====================

/// 通知表
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("SYSTEM") // SYSTEM/TASK/RELATIONSHIP/REWARD/ACHIEVEMENT
  title     String
  content   String?
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

/// 私信表
model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ==================== 系统配置 ====================

/// 系统配置表
model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  type      String   @default("string")
  updatedAt DateTime @updatedAt

  @@index([key])
}

/// 敏感词表
model SensitiveWord {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  category  String
  level     Int      @default(1) // 1 警告 2 屏蔽 3 封禁
  createdAt DateTime @default(now())

  @@index([category])
}

// ==================== 小屋扩展系统 ====================

/// 每日任务进度表
model DailyTaskProgress {
  id           Int      @id @default(autoincrement())
  userId       Int
  date         String   // YYYY-MM-DD
  progressData String   @default("{}") // JSON: { taskId: progress }
  claimedTasks String   @default("[]") // JSON: [taskId1, taskId2]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// 小屋访客记录表
model CottageVisit {
  id         Int      @id @default(autoincrement())
  cottageId  Int
  visitorId  Int
  message    String?
  gift       String?  // JSON: { type, amount }
  liked      Boolean  @default(false)
  visitTime  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([cottageId])
  @@index([visitorId])
  @@index([visitTime])
}

/// 装饰合成记录表
model SynthesisRecord {
  id                   Int      @id @default(autoincrement())
  userId               Int
  recipeId             String
  success              Boolean
  obtainedDecorationId Int?
  consumedDecorationIds String @default("[]") // JSON: [id1, id2, id3]
  createdAt            DateTime @default(now())

  @@index([userId])
}
